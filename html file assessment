<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>How Ready Is Your Security Operation for AI? | Zygal</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,400;0,500;0,600;0,700;0,800@1&display=swap" rel="stylesheet">
<style>
  :root{
    --page-bg-0:#eef1f6;
    --page-bg-1:#e4e9f1;
    --page-text:#1a2136;
    --page-muted:#5b6577;
    --panel:#0a1120;
    --panel-2:#111c33;
    --border:rgba(255,255,255,0.08);
    --border-strong:rgba(255,255,255,0.16);
    --green:#45ba64;
    --blue:#498af4;
    --yellow:#f5be4a;
    --text:#f4f7fb;
    --muted:#93a1bc;
    --muted-2:#6b7996;
    --radius-lg:22px;
    --radius-md:14px;
    --radius-pill:999px;
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  body{
    min-height:100vh;
    background:
      radial-gradient(760px 460px at 6% -8%, rgba(69,186,100,0.10), transparent 60%),
      radial-gradient(680px 500px at 106% 12%, rgba(73,138,244,0.10), transparent 60%),
      radial-gradient(560px 440px at 90% 106%, rgba(245,190,74,0.09), transparent 60%),
      linear-gradient(160deg, var(--page-bg-0), var(--page-bg-1));
    font-family:'Poppins',-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;
    color:var(--page-text);
    display:flex;
    align-items:center;
    justify-content:center;
    padding:40px 18px;
  }
  .wrap{
    width:100%;
    max-width:640px;
  }
  .brand-row{
    display:flex;
    align-items:center;
    gap:10px;
    margin-bottom:22px;
    padding-left:4px;
  }
  .brand-row img{ height:26px; width:auto; display:block; }
  .brand-row span{
    font-weight:600;
    font-size:15px;
    letter-spacing:0.2px;
    color:var(--page-text);
  }
  .card{
    position:relative;
    background:
      repeating-linear-gradient(180deg, rgba(255,255,255,0.014) 0px, rgba(255,255,255,0.014) 1px, transparent 1px, transparent 3px),
      radial-gradient(480px 260px at 100% 0%, rgba(73,138,244,0.10), transparent 60%),
      linear-gradient(165deg, var(--panel), var(--panel-2));
    border:1px solid var(--border);
    border-radius:var(--radius-lg);
    padding:44px 40px 36px;
    overflow:hidden;
    box-shadow:
      0 40px 70px -28px rgba(16,22,38,0.45),
      0 14px 34px -18px rgba(69,186,100,0.16),
      0 0 0 1px rgba(255,255,255,0.02) inset;
  }
  .hexline{
    position:absolute;
    bottom:-46px;
    left:-46px;
    width:200px;
    height:200px;
    opacity:0.14;
    pointer-events:none;
  }
  .corner{
    position:absolute;
    width:16px;
    height:16px;
    border-color:rgba(255,255,255,0.22);
    pointer-events:none;
  }
  .corner.tl{ top:16px; left:16px; border-top:1.4px solid; border-left:1.4px solid; border-top-left-radius:4px; }
  .corner.tr{ top:16px; right:16px; border-top:1.4px solid; border-right:1.4px solid; border-top-right-radius:4px; }
  .corner.bl{ bottom:16px; left:16px; border-bottom:1.4px solid; border-left:1.4px solid; border-bottom-left-radius:4px; }
  .corner.br{ bottom:16px; right:16px; border-bottom:1.4px solid; border-right:1.4px solid; border-bottom-right-radius:4px; }
  .live-dot{
    position:absolute;
    top:22px;
    right:24px;
    display:flex;
    align-items:center;
    gap:7px;
    font-size:11px;
    font-weight:500;
    color:var(--muted-2);
    letter-spacing:0.2px;
    z-index:2;
  }
  .live-dot .pulse{
    width:7px; height:7px;
    border-radius:50%;
    background:var(--green);
    box-shadow:0 0 0 0 rgba(69,186,100,0.6);
    animation:pulse 2.2s ease-out infinite;
  }
  @keyframes pulse{
    0%{ box-shadow:0 0 0 0 rgba(69,186,100,0.55); }
    70%{ box-shadow:0 0 0 7px rgba(69,186,100,0); }
    100%{ box-shadow:0 0 0 0 rgba(69,186,100,0); }
  }
  /* ---------- Screens ---------- */
  .screen{ display:none; position:relative; z-index:1; }
  .screen.active{ display:block; animation:fadeIn 0.45s ease; }
  @keyframes fadeIn{ from{opacity:0; transform:translateY(6px);} to{opacity:1; transform:translateY(0);} }

  /* ---------- Intro ---------- */
  #screen-intro h1{
    font-size:29px;
    line-height:1.28;
    font-weight:700;
    margin:0 0 14px;
    letter-spacing:-0.3px;
  }
  #screen-intro p.lead{
    color:var(--muted);
    font-size:15.5px;
    line-height:1.6;
    margin:0 0 26px;
    max-width:46ch;
  }
  .meta-row{
    display:flex;
    gap:18px;
    margin-bottom:30px;
    flex-wrap:wrap;
  }
  .meta-chip{
    display:flex;
    align-items:center;
    gap:8px;
    font-size:13px;
    color:var(--muted);
    background:rgba(255,255,255,0.04);
    border:1px solid var(--border);
    padding:8px 14px;
    border-radius:var(--radius-pill);
  }
  .meta-chip .dot{ width:7px; height:7px; border-radius:50%; }

  /* ---------- Buttons ---------- */
  .btn-primary{
    display:inline-flex;
    align-items:center;
    gap:10px;
    background:var(--green);
    color:#08130c;
    font-family:inherit;
    font-weight:700;
    font-size:15.5px;
    border:none;
    padding:15px 26px;
    border-radius:var(--radius-pill);
    cursor:pointer;
    transition:transform 0.15s ease, box-shadow 0.15s ease, background 0.15s ease;
    box-shadow:0 10px 24px -10px rgba(69,186,100,0.55);
  }
  .btn-primary:hover{ transform:translateY(-1px); box-shadow:0 14px 28px -10px rgba(69,186,100,0.65); }
  .btn-primary:active{ transform:translateY(0); }
  .btn-primary svg{ width:16px; height:16px; }
  .btn-ghost{
    background:none;
    border:none;
    color:var(--muted);
    font-family:inherit;
    font-size:14px;
    font-weight:500;
    cursor:pointer;
    padding:10px 4px;
    display:inline-flex;
    align-items:center;
    gap:6px;
  }
  .btn-ghost:hover{ color:var(--text); }

  /* ---------- Progress ---------- */
  .progress-track{
    height:5px;
    width:100%;
    background:rgba(255,255,255,0.07);
    border-radius:var(--radius-pill);
    overflow:hidden;
    margin-bottom:10px;
  }
  .progress-fill{
    height:100%;
    border-radius:var(--radius-pill);
    background:linear-gradient(90deg, var(--green), var(--blue), var(--yellow));
    background-size:300% 100%;
    transition:width 0.4s ease;
  }
  .progress-label{
    font-size:12.5px;
    color:var(--muted-2);
    font-weight:500;
    margin-bottom:28px;
  }

  /* ---------- Question ---------- */
  .q-title{
    font-size:21px;
    font-weight:600;
    line-height:1.4;
    margin:0 0 22px;
    letter-spacing:-0.1px;
  }
  .options{
    display:flex;
    flex-direction:column;
    gap:10px;
    margin-bottom:26px;
  }
  .option{
    text-align:left;
    background:rgba(255,255,255,0.03);
    border:1px solid var(--border);
    color:var(--text);
    font-family:inherit;
    font-size:15px;
    font-weight:500;
    padding:15px 18px;
    border-radius:var(--radius-md);
    cursor:pointer;
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:12px;
    transition:border-color 0.15s ease, background 0.15s ease, transform 0.1s ease;
  }
  .option:hover{ border-color:var(--border-strong); background:rgba(255,255,255,0.055); }
  .option.selected{
    border-color:var(--green);
    background:rgba(69,186,100,0.10);
  }
  .option .tick{
    width:18px; height:18px; border-radius:50%;
    border:1.6px solid var(--muted-2);
    flex:0 0 auto;
    display:flex; align-items:center; justify-content:center;
  }
  .option.selected .tick{ border-color:var(--green); background:var(--green); }
  .option.selected .tick svg{ display:block; }
  .option .tick svg{ display:none; width:10px; height:10px; }
  .nav-row{
    display:flex;
    align-items:center;
    justify-content:space-between;
  }

  /* ---------- Results ---------- */
  .result-top{
    display:flex;
    gap:26px;
    align-items:center;
    margin-bottom:26px;
    flex-wrap:wrap;
  }
  .gauge-wrap{ position:relative; width:132px; height:132px; flex:0 0 auto; }
  .gauge-wrap svg{ transform:rotate(-90deg); }
  .gauge-num{
    position:absolute; inset:0;
    display:flex; flex-direction:column; align-items:center; justify-content:center;
  }
  .gauge-num .n{ font-size:30px; font-weight:700; line-height:1; }
  .gauge-num .d{ font-size:11px; color:var(--muted-2); margin-top:4px; }
  .result-tier{
    flex:1;
    min-width:200px;
  }
  .tier-pill{
    display:inline-block;
    font-size:12.5px;
    font-weight:600;
    padding:6px 13px;
    border-radius:var(--radius-pill);
    margin-bottom:10px;
  }
  .result-tier h2{
    font-size:21px;
    font-weight:700;
    margin:0 0 6px;
    letter-spacing:-0.2px;
  }
  .result-tier p{
    font-size:14px;
    color:var(--muted);
    margin:0;
    line-height:1.55;
  }
  .rec-block{
    background:rgba(255,255,255,0.03);
    border:1px solid var(--border);
    border-radius:var(--radius-md);
    padding:20px 22px;
    margin-bottom:26px;
  }
  .rec-block h3{
    font-size:13.5px;
    font-weight:600;
    margin:0 0 14px;
    color:var(--text);
  }
  .rec-list{ list-style:none; margin:0; padding:0; display:flex; flex-direction:column; gap:12px; }
  .rec-list li{
    display:flex;
    gap:11px;
    font-size:14px;
    color:var(--muted);
    line-height:1.55;
  }
  .rec-list .bullet{
    flex:0 0 auto;
    width:6px; height:6px;
    border-radius:50%;
    margin-top:7px;
  }
  .cta-row{
    display:flex;
    align-items:center;
    gap:18px;
    flex-wrap:wrap;
  }

  @media (max-width:480px){
    .card{ padding:32px 22px 28px; }
    #screen-intro h1{ font-size:24px; }
    .q-title{ font-size:19px; }
    .result-top{ flex-direction:column; align-items:flex-start; }
  }

  @media (prefers-reduced-motion: reduce){
    .screen.active{ animation:none; }
    *{ transition:none !important; }
  }
</style>
</head>
<body>

<div class="wrap">
  <div class="brand-row">
    <img src="data:image/png;base64," alt="Zygal">
    <span>Zygal</span>
  </div>

  <div class="card">
    <svg class="hexline" viewBox="0 0 220 220" fill="none">
      <polygon points="110,20 180,58 180,134 110,172 40,134 40,58" stroke="rgba(255,255,255,0.5)" stroke-width="1.4"/>
      <polygon points="110,58 150,80 150,124 110,146 70,124 70,80" stroke="rgba(255,255,255,0.35)" stroke-width="1.2"/>
    </svg>
    <div class="corner tl"></div>
    <div class="corner tr"></div>
    <div class="corner bl"></div>
    <div class="corner br"></div>
    <div class="live-dot"><span class="pulse"></span>Live assessment</div>

    <!-- ================= INTRO ================= -->
    <div class="screen active" id="screen-intro">
      <h1>How ready is your security operation for AI?</h1>
      <p class="lead">Answer six quick questions about how your cameras are monitored today, and get a readiness score plus a short set of next steps for your team.</p>
      <div class="meta-row">
        <div class="meta-chip"><span class="dot" style="background:var(--green)"></span>Takes about 60 seconds</div>
        <div class="meta-chip"><span class="dot" style="background:var(--blue)"></span>6 questions</div>
        <div class="meta-chip"><span class="dot" style="background:var(--yellow)"></span>No sign-up required</div>
      </div>
      <button class="btn-primary" onclick="startQuiz()">
        Start the assessment
        <svg viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="#08130c" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
    </div>

    <!-- ================= QUIZ ================= -->
    <div class="screen" id="screen-quiz">
      <div class="progress-track"><div class="progress-fill" id="progressFill" style="width:0%"></div></div>
      <div class="progress-label" id="progressLabel">Question 1 of 6</div>
      <h2 class="q-title" id="qTitle"></h2>
      <div class="options" id="qOptions"></div>
      <div class="nav-row">
        <button class="btn-ghost" id="backBtn" onclick="goBack()">
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M13 8H3M7 4L3 8l4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          Back
        </button>
        <span></span>
      </div>
    </div>

    <!-- ================= RESULTS ================= -->
    <div class="screen" id="screen-result">
      <div class="result-top">
        <div class="gauge-wrap">
          <svg width="132" height="132" viewBox="0 0 132 132">
            <circle cx="66" cy="66" r="56" stroke="rgba(255,255,255,0.08)" stroke-width="12" fill="none"/>
            <circle id="gaugeArc" cx="66" cy="66" r="56" stroke="var(--green)" stroke-width="12" fill="none"
              stroke-linecap="round" stroke-dasharray="352" stroke-dashoffset="352"/>
          </svg>
          <div class="gauge-num">
            <div class="n" id="scoreNum">0</div>
            <div class="d">out of 100</div>
          </div>
        </div>
        <div class="result-tier">
          <span class="tier-pill" id="tierPill"></span>
          <h2 id="tierHeadline"></h2>
          <p id="tierBlurb"></p>
        </div>
      </div>

      <div class="rec-block">
        <h3 id="recIntro">Where to focus next</h3>
        <ul class="rec-list" id="recList"></ul>
      </div>

      <div class="cta-row">
        <a class="btn-primary" id="ctaBtn" href="#" target="_blank" rel="noopener">
          Talk to a Zygal specialist
          <svg viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="#08130c" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
        <button class="btn-ghost" onclick="restartQuiz()">Retake assessment</button>
      </div>
    </div>

  </div>
</div>

<script>
/* ============================================================
   ZYGAL — AI Readiness Assessment
   Edit QUESTIONS, RESULT COPY, and CTA_URL below to customize.
   ============================================================ */

// Where the CTA button on the results screen should send people.
var CTA_URL = "https://www.zygal.com/demo"; // <-- replace with your real demo/contact link

var QUESTIONS = [
  {
    id: "cameras",
    title: "How many cameras does your operation currently manage?",
    scored: false,
    options: [
      { label: "Under 25", points: 0 },
      { label: "25–100", points: 0 },
      { label: "101–500", points: 0 },
      { label: "500+", points: 0 }
    ]
  },
  {
    id: "locations",
    title: "How many locations or sites are you monitoring?",
    scored: false,
    options: [
      { label: "1 location", points: 0 },
      { label: "2–5 locations", points: 0 },
      { label: "6–20 locations", points: 0 },
      { label: "20+ locations", points: 0 }
    ]
  },
  {
    id: "monitoring",
    title: "How is footage monitored today?",
    scored: true,
    options: [
      { label: "24/7 live monitoring by staff", points: 8 },
      { label: "Reactive — footage is reviewed only after an incident", points: 4 },
      { label: "Hybrid — some live monitoring, mostly reactive", points: 14 },
      { label: "Rule-based alerts already flag activity automatically", points: 25 }
    ]
  },
  {
    id: "vms",
    title: "What video management system (VMS) are you running?",
    scored: true,
    options: [
      { label: "No formal VMS — cameras or DVR only", points: 5 },
      { label: "Basic VMS for local recording and playback", points: 12 },
      { label: "Enterprise VMS (e.g. Milestone, Genetec, Avigilon)", points: 20 },
      { label: "Cloud-based VMS already in place", points: 25 }
    ]
  },
  {
    id: "analytics",
    title: "What AI or video analytics do you use today?",
    scored: true,
    options: [
      { label: "None", points: 3 },
      { label: "Basic motion or line-crossing detection", points: 10 },
      { label: "Object or person detection", points: 18 },
      { label: "Advanced analytics (behavior detection, LPR, etc.)", points: 25 }
    ]
  },
  {
    id: "centralization",
    title: "How is monitoring organized across your sites?",
    scored: true,
    options: [
      { label: "Fully distributed — each site handles its own monitoring", points: 6 },
      { label: "Partially centralized — some sites report to HQ", points: 14 },
      { label: "One centralized control room for all sites", points: 20 },
      { label: "Centralized cloud platform, accessible from anywhere", points: 25 }
    ]
  }
];

var RECOMMENDATIONS = {
  monitoring: "Shift from manual or reactive review to AI-driven alerts, so your team is notified the moment something matters instead of scrubbing through hours of footage.",
  vms: "A modern VMS — or a cloud analytics layer on top of your current one — is the foundation AI plugs into. For most teams, this is the fastest infrastructure upgrade.",
  analytics: "You're not using AI analytics yet. Even basic object detection can cut false alarms significantly and free up your team's attention for real events.",
  centralization: "Centralize monitoring, even virtually through a cloud platform, so one team can oversee every site instead of duplicating effort location by location."
};

var TIERS = [
  { max:40, key:"reactive", pill:"Reactive", pillColor:"var(--yellow)", headline:"Mostly manual, with real room to grow",
    blurb:"Your team is likely spending significant time watching or reviewing footage manually. AI can take on that first layer of attention immediately." },
  { max:65, key:"emerging", pill:"Emerging", pillColor:"var(--blue)", headline:"Ready to pilot AI on existing cameras",
    blurb:"You have some structure in place. Adding AI analytics to your current cameras is likely a fast, low-disruption next step." },
  { max:85, key:"advancing", pill:"Advancing", pillColor:"var(--green)", headline:"Solid infrastructure, ready to scale AI",
    blurb:"Your setup can support AI across more of your sites. The opportunity now is consistency and centralized oversight." },
  { max:100, key:"ai-ready", pill:"AI-Ready", pillColor:"var(--green)", headline:"Well positioned for full AI transformation",
    blurb:"You're already close to best practice. Fine-tuning your AI analytics and centralizing insights will get you the rest of the way." }
];

var current = 0;
var answers = {};

function startQuiz(){
  showScreen('screen-quiz');
  current = 0;
  renderQuestion();
}

function showScreen(id){
  document.querySelectorAll('.screen').forEach(function(s){ s.classList.remove('active'); });
  document.getElementById(id).classList.add('active');
}

function renderQuestion(){
  var q = QUESTIONS[current];
  document.getElementById('progressLabel').textContent = 'Question ' + (current+1) + ' of ' + QUESTIONS.length;
  document.getElementById('progressFill').style.width = ((current) / QUESTIONS.length * 100) + '%';
  document.getElementById('qTitle').textContent = q.title;
  document.getElementById('backBtn').style.visibility = current === 0 ? 'hidden' : 'visible';

  var wrap = document.getElementById('qOptions');
  wrap.innerHTML = '';
  q.options.forEach(function(opt){
    var btn = document.createElement('button');
    btn.className = 'option';
    var selected = answers[q.id] && answers[q.id].label === opt.label;
    if(selected) btn.classList.add('selected');
    btn.innerHTML = '<span>'+opt.label+'</span><span class="tick"><svg viewBox="0 0 10 10" fill="none"><path d="M1.5 5l2.3 2.5L8.5 2" stroke="#08130c" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></span>';
    btn.onclick = function(){ selectOption(q, opt); };
    wrap.appendChild(btn);
  });
}

function selectOption(q, opt){
  answers[q.id] = opt;
  renderQuestion();
  setTimeout(function(){
    if(current < QUESTIONS.length - 1){
      current++;
      renderQuestion();
    } else {
      document.getElementById('progressFill').style.width = '100%';
      setTimeout(showResult, 250);
    }
  }, 280);
}

function goBack(){
  if(current > 0){
    current--;
    renderQuestion();
  }
}

function showResult(){
  var score = 0;
  var scoredAnswers = [];
  QUESTIONS.forEach(function(q){
    if(q.scored && answers[q.id]){
      score += answers[q.id].points;
      scoredAnswers.push({ id:q.id, points:answers[q.id].points });
    }
  });

  var tier = TIERS[TIERS.length-1];
  for(var i=0;i<TIERS.length;i++){ if(score <= TIERS[i].max){ tier = TIERS[i]; break; } }

  scoredAnswers.sort(function(a,b){ return a.points - b.points; });
  var weakest = scoredAnswers.slice(0,2);

  document.getElementById('scoreNum').textContent = '0';
  document.getElementById('tierPill').textContent = tier.pill;
  document.getElementById('tierPill').style.background = tier.pillColor;
  document.getElementById('tierPill').style.color = '#08130c';
  document.getElementById('tierHeadline').textContent = tier.headline;
  document.getElementById('tierBlurb').textContent = tier.blurb;
  document.getElementById('ctaBtn').href = CTA_URL;

  var colors = ['var(--yellow)','var(--blue)','var(--green)','var(--green)'];
  document.getElementById('gaugeArc').style.stroke = tier.pillColor;

  var recList = document.getElementById('recList');
  recList.innerHTML = '';
  var dotColors = ['var(--yellow)','var(--blue)'];
  weakest.forEach(function(w, idx){
    var li = document.createElement('li');
    li.innerHTML = '<span class="bullet" style="background:'+dotColors[idx % dotColors.length]+'"></span><span>'+RECOMMENDATIONS[w.id]+'</span>';
    recList.appendChild(li);
  });

  showScreen('screen-result');

  // animate gauge + number count-up
  var circumference = 352;
  var offset = circumference - (score/100)*circumference;
  var arc = document.getElementById('gaugeArc');
  requestAnimationFrame(function(){
    arc.style.transition = 'stroke-dashoffset 1s ease';
    arc.style.strokeDashoffset = offset;
  });
  var numEl = document.getElementById('scoreNum');
  var startTime = null;
  function step(ts){
    if(!startTime) startTime = ts;
    var progress = Math.min((ts-startTime)/900, 1);
    numEl.textContent = Math.round(progress*score);
    if(progress < 1) requestAnimationFrame(step);
  }
  requestAnimationFrame(step);
}

function restartQuiz(){
  answers = {};
  current = 0;
  showScreen('screen-intro');
}
</script>
